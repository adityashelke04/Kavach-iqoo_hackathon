# Cloud engine (SPEC 8.2). Set these in Vercel project settings, never here.
# Without them the cloud engine is silently unavailable and the rules engine
# answers on its own, which is a working state.

# Required for the cloud engine.
OPENROUTER_API_KEY=

# Optional. Defaults to google/gemini-2.0-flash-001 in api/analyze.ts.
KAVACH_CLOUD_MODEL=
